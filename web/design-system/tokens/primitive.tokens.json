        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0
        }
      }
    },
    "spacing": {
      "$type": "dimension",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "half": { "$value": { "value": 2, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "1-5": { "$value": { "value": 6, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "2-5": { "$value": { "value": 10, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "3-5": { "$value": { "value": 14, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "4-5": { "$value": { "value": 18, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } },
      "20": { "$value": { "value": 80, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "px" } },
      "small": { "$value": { "value": 6, "unit": "px" } },
      "medium": { "$value": { "value": 10, "unit": "px" } },
      "large": { "$value": { "value": 14, "unit": "px" } },
      "x-large": { "$value": { "value": 16, "unit": "px" } },
      "2x-large": { "$value": { "value": 24, "unit": "px" } },
      "full": { "$value": { "value": 9999, "unit": "px" } }
    },
    "size": {
      "$type": "dimension",
      "control": {
        "small": { "$value": { "value": 34, "unit": "px" } },
        "medium": { "$value": { "value": 40, "unit": "px" } },
        "large": { "$value": { "value": 44, "unit": "px" } }
      },
      "tap-target": {
        "$value": { "value": 44, "unit": "px" }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Inter Variable",
            "Inter",
            "PingFang SC",
            "Microsoft YaHei",
            "Noto Sans SC",
            "sans-serif"
          ]
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "SFMono-Regular",
            "Consolas",
            "Liberation Mono",
            "monospace"
          ]
        }
      },
      "size": {
        "$type": "dimension",
        "overline": { "$value": { "value": 11, "unit": "px" } },
        "caption": { "$value": { "value": 12, "unit": "px" } },
        "body": { "$value": { "value": 14, "unit": "px" } },
        "body-large": { "$value": { "value": 16, "unit": "px" } },
        "subtitle": { "$value": { "value": 18, "unit": "px" } },
        "section": { "$value": { "value": 24, "unit": "px" } },
        "title": { "$value": { "value": 32, "unit": "px" } },
        "display": { "$value": { "value": 52, "unit": "px" } }
      },
      "line-height": {
        "$type": "number",
        "compact": { "$value": 1.08 },
        "heading": { "$value": 1.25 },
        "body": { "$value": 1.5714 },
        "caption": { "$value": 1.5 }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      },
      "tracking": {
        "$type": "dimension",
        "tight": { "$value": { "value": -0.72, "unit": "px" } },
        "normal": { "$value": { "value": 0, "unit": "px" } },
        "wide": { "$value": { "value": 1.21, "unit": "px" } }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": { "value": 120, "unit": "ms" } },
        "standard": { "$value": { "value": 180, "unit": "ms" } },
        "slow": { "$value": { "value": 260, "unit": "ms" } }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0, 0, 1] },
        "emphasized": { "$value": [0.2, 0.8, 0.2, 1] }
      }
    },
    "layer": {
      "$type": "number",
      "base": { "$value": 0 },
      "raised": { "$value": 10 },
      "sticky": { "$value": 30 },
      "overlay": { "$value": 50 },
      "dialog": { "$value": 60 },
      "toast": { "$value": 70 },
      "tooltip": { "$value": 80 }
    }
  }
}
