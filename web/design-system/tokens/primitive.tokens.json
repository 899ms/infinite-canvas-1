{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.shared-ui.meta": {
      "name": "Shared UI primitive tokens",
      "version": "0.1.2",
      "scope": "portable-foundation"
    }
  },
